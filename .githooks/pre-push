#!/usr/bin/env bash
# Local stand-in for branch protection (GitHub needs Pro for it on a private repo; docs/ci.md).
# Runs what CI's `checks` job runs that is fast and free: lint and the unit suite, with database
# and API credentials removed so a push never touches production or spends money. It guards
# this machine only and leaves no record on GitHub. Skip once with `git push --no-verify`.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
PY=.venv/Scripts/python.exe; [ -x "$PY" ] || PY=.venv/bin/python
RUFF=.venv/Scripts/ruff.exe; [ -x "$RUFF" ] || RUFF=.venv/bin/ruff
echo "pre-push: ruff"
"$RUFF" check --select F,E9 --exclude .venv . --quiet
echo "pre-push: unit tests (no credentials)"
if ! env -u STUDBOOK_DATABASE_URL -u STUDBOOK_INGEST_DATABASE_URL -u ANTHROPIC_API_KEY \
    "$PY" -m unittest discover -s tests > .git/pre-push-tests.log 2>&1; then
  tail -30 .git/pre-push-tests.log
  echo "pre-push: unit tests failed; push refused (log: .git/pre-push-tests.log)" >&2
  exit 1
fi
tail -1 .git/pre-push-tests.log
