# Copy to .env (gitignored) or set as Windows User environment variables. Never commit real
# values. store/bootstrap_db.py sets STUDBOOK_ADMIN_DATABASE_URL, STUDBOOK_INGEST_DATABASE_URL
# and STUDBOOK_DATABASE_URL itself (registry write, never printed) -- this file documents them,
# it isn't how they're normally set.

# The studbook Supabase project's own `postgres` connection string (Project Settings -> Database
# -> Connection string -> direct connection), with the bracketed placeholder replaced by the real
# password. Superuser-equivalent: only used to run store/bootstrap_db.py, never by the app.
STUDBOOK_ADMIN_DATABASE_URL=

# Written by store/bootstrap_db.py: the studbook_ingest_login role (read/write on documents and
# chunks) and the studbook_reader_login role (read-only there; read/write on eval_runs).
STUDBOOK_INGEST_DATABASE_URL=
STUDBOOK_DATABASE_URL=

# Anthropic API key for answer generation (M3) and the LLM judge (M4).
ANTHROPIC_API_KEY=

# Bearer token for the service's data routes (/repos, /search, /ask). The server refuses to start
# without one -- the corpus holds client-shaped material, so the routes are never open. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# The page asks for it once per tab and keeps it in sessionStorage only.
STUDBOOK_API_KEY=

# Optional overrides.
STUDBOOK_GENERATOR_MODEL=claude-haiku-4-5-20251001
STUDBOOK_EMBED_MODEL=BAAI/bge-base-en-v1.5
